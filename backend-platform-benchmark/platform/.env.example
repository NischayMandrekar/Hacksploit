# Generate independent secrets with: openssl rand -hex 32
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_MASTER_KEY=replace_with_openssl_rand_hex_32_output
AUTH_JWT_SECRET=replace_with_a_different_openssl_rand_hex_32_output
AUTH_JWT_ISSUER=local-backend-platform
AUTH_JWT_AUDIENCE=local-backend-platform-api
AUTH_ACCESS_TOKEN_SECONDS=600
AUTH_REFRESH_TOKEN_DAYS=14

# Compose-internal PostgreSQL URL. Do not publish the database port.
DATABASE_URL=postgresql+psycopg://platform:platform_dev_only@db:5432/platform

# Worker and job bounds
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_CONCURRENCY=2
WORKER_LEASE_SECONDS=45
WORKER_EXECUTION_TIMEOUT_SECONDS=30
WORKER_MAX_ATTEMPTS=3
JOB_MAX_INPUT_BYTES=65536
JOB_MAX_OUTPUT_BYTES=65536
JOB_DEFAULT_TIMEOUT_SECONDS=10
JOB_MAX_TIMEOUT_SECONDS=30

# Optional integrations; leave blank unless using the matching Compose profile.
RABBITMQ_URL=
RABBITMQ_QUEUE=platform.job-wakeups
REDIS_URL=
KAFKA_BOOTSTRAP=
KAFKA_TOPIC=platform.job-events
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
PROMETHEUS_ENABLED=true
